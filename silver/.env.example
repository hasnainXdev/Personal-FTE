# MCP Server Configuration
MCP_PORT=8765
MCP_HOST=localhost

# Gmail OAuth (for Gmail Watcher)
GMAIL_OAUTH_TOKEN=
GMAIL_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# SMTP Configuration (for Email Actions)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# LinkedIn API (for LinkedIn Automation)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# Google Calendar API (optional, for scheduling)
GOOGLE_CALENDAR_TOKEN=

# Watcher Configuration
WATCHER_POLL_INTERVAL=60
WATCHER_GMAIL_ENABLED=true
WATCHER_FILESYSTEM_ENABLED=true

# Scheduler Configuration
SCHEDULER_ENABLED=true
DAILY_SUMMARY_TIME=09:00
