# Environment Variables for Gold Tier AI Employee
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# GMAIL API CONFIGURATION
# =============================================================================
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:8080/
GMAIL_CREDENTIALS_PATH=./credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=./credentials/gmail_token.pickle

# =============================================================================
# ODOO CONFIGURATION (Community Edition)
# =============================================================================
ODOO_URL=http://localhost:8069
ODOO_DB=your_odoo_database
ODOO_USERNAME=your_odoo_username
ODOO_API_KEY=your_odoo_api_key

# =============================================================================
# FACEBOOK CONFIGURATION (Gold Tier)
# =============================================================================
# Run: python auth_facebook.py to authenticate and auto-fill these values
#
# To get Facebook API credentials:
# 1. Go to https://developers.facebook.com
# 2. Create a new App (Business type recommended)
# 3. Add Facebook Login product
# 4. Get App ID and App Secret from Settings → Basic
# 5. Run auth_facebook.py to get Page Access Token
#
# Or manually:
# - Get User Token from Graph API Explorer
# - Exchange for Page Token via /me/accounts endpoint
#
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
VAULT_PATH=./AI_Employee_Vault
LOG_LEVEL=INFO
DRY_RUN=false
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
TIMEZONE=UTC

# =============================================================================
# SECURITY
# =============================================================================
ENCRYPTION_KEY=your_encryption_key_here
SESSION_SECRET=your_session_secret_here
