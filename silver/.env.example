# MCP Server Configuration
MCP_PORT=8765
MCP_HOST=localhost

# ===========================================
# EMAIL CONFIGURATION (Choose one method)
# ===========================================

# --- Option A: Gmail API (OAuth 2.0) ---
# Run: python -m ai_employee.services.gmail_oauth to authorize
# Tokens stored securely in: AI_Employee_Vault/Skills/gmail_token.json
GMAIL_OAUTH_ENABLED=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_TOKEN=
GMAIL_REFRESH_TOKEN=

# --- Option B: SMTP (Gmail App Password) ---
# Setup: Enable 2FA, then create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===========================================
# LINKEDIN AUTOMATION (Playwright)
# ===========================================
# Security: Uses browser automation with anti-detection measures
# Tokens stored in: AI_Employee_Vault/Skills/linkedin_cookies.json

# LinkedIn Credentials (required for Playwright)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Security Settings
LINKEDIN_REQUIRE_CONFIRMATION=true  # Require manual confirmation before posting
LINKEDIN_HEADLESS=false  # Show browser window (recommended for first use)

# Rate Limiting (built-in safeguards)
# Max 20 actions/hour with random delays (30-120s between actions)

# LinkedIn API (Alternative - requires approval, limited functionality)
# Note: API doesn't support job applications or DMs
LINKEDIN_API_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# ===========================================
# GOOGLE CALENDAR API (OPTIONAL)
# ===========================================
GOOGLE_CALENDAR_TOKEN=

# ===========================================
# WATCHER CONFIGURATION
# ===========================================
WATCHER_POLL_INTERVAL=60
WATCHER_GMAIL_ENABLED=true
WATCHER_FILESYSTEM_ENABLED=true

# ===========================================
# SCHEDULER CONFIGURATION
# ===========================================
SCHEDULER_ENABLED=true
DAILY_SUMMARY_TIME=09:00
